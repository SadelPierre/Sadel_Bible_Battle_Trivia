# ─────────────────────────────────────────────────────────────
# Bible Battle Live — environment variables
#
# SAFE FOR THE BROWSER (NEXT_PUBLIC_ prefix — bundled into client JS):
#   NEXT_PUBLIC_SUPABASE_URL       — your Supabase project URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY — modern browser-safe Supabase key
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  — optional legacy fallback (do not set both)
#   NEXT_PUBLIC_APP_URL            — canonical URL of the deployed app (for invite links)
#
# SERVER-ONLY (never expose, never prefix with NEXT_PUBLIC_):
#   SUPABASE_SECRET_KEY            — modern server-only secret key
#   SUPABASE_SERVICE_ROLE_KEY      — optional legacy fallback (do not set both)
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
